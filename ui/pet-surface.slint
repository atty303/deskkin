export component PetSurface inherits Rectangle {
    in property <int> animation-row: 0;
    in property <int> frame-index: 0;
    in property <bool> benchmark-active: false;
    in property <int> benchmark-frame: 0;

    background: root.benchmark-active && Math.mod(root.benchmark-frame, 2) == 0 ? #151b26 : #171d29;
    clip: true;

    Rectangle {
        x: root.benchmark-active ? -80px + Math.mod(root.benchmark-frame * 3, 400) * 1px : -80px;
        y: 36px;
        width: 100px;
        height: 64px;
        border-radius: 32px;
        background: #233650;
    }

    Rectangle {
        x: root.benchmark-active ? 320px - Math.mod(root.benchmark-frame * 5, 420) * 1px : 320px;
        y: 92px;
        width: 120px;
        height: 72px;
        border-radius: 12px;
        background: #304764;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 44px;
        width: 100%;
        height: 44px;
        background: #202c3d;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 44px;
        width: 100%;
        height: 2px;
        background: #51647f;
    }

    Rectangle {
        x: root.benchmark-active ? -160px + Math.mod(root.benchmark-frame * 7, 520) * 1px : -160px;
        y: parent.height - 62px;
        width: 180px;
        height: 18px;
        border-radius: 9px;
        background: #617b9f;
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 144px;
        height: 156px;
        source: @image-url("../assets/pets/koyori/atlas.png");
        source-clip-x: root.frame-index * 144;
        source-clip-y: root.animation-row * 156;
        source-clip-width: 144;
        source-clip-height: 156;
        image-fit: contain;
    }
}
