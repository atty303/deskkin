export component AvailabilityBillboard inherits Rectangle {
    in property <string> status-text: "Unknown";
    in property <color> status-color: #f3b33d;

    background: #202c2e;
    border-radius: 14px;
    border-width: 2px;
    border-color: #4d6660;

    Rectangle {
        x: 20px; y: 23px; width: 8px; height: 8px;
        border-radius: 4px;
        background: root.status-color;
    }
    Text {
        x: 38px; y: 15px;
        text: "AVAILABILITY";
        color: #a6b9ad;
        font-size: 18px;
        font-weight: 600;
    }
    Text {
        x: 20px; y: 36px; width: parent.width - 40px; height: 40px;
        text: root.status-text;
        color: root.status-color;
        font-size: 30px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: 20px; y: 79px; width: parent.width - 40px;
        text: root.status-text == "Unknown" ? "Waiting for a fresh signal." : root.status-text == "Available" ? "Here, when you need company." : "A little quiet time for now.";
        color: #b6c9bd;
        font-size: 16px;
    }
    Rectangle {
        x: 20px; y: parent.height - 15px; width: parent.width - 40px; height: 2px;
        background: #3d514b;
    }
}

export component NoticeBillboard inherits Rectangle {
    in property <string> notice-text: "Deskkin notice";

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        background: #302b26;
        border-width: 2px;
        border-color: #8c7751;

        Text {
            x: 20px; y: 14px;
            text: "NOTICE";
            color: #c8ac79;
            font-size: 18px;
            font-weight: 600;
        }

        Text {
            text: root.notice-text;
            x: 20px; y: 40px; width: parent.width - 40px; height: parent.height - 48px;
            color: #f1dfb9;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component ApplicationSurface inherits Rectangle {
    in property <int> demo-card: -1;
    in property <string> status-text: "Unknown";
    in property <color> status-color: #f3b33d;
    in property <bool> notice-visible: false;
    in property <string> notice-text: "";
    in property <bool> capture-only-notice: false;

    background: transparent;

    AvailabilityBillboard {
        width: 100%;
        height: 100%;
        status-text: root.status-text;
        status-color: root.status-color;
        visible: root.demo-card < 0 && !root.capture-only-notice;
    }

    NoticeBillboard {
        x: root.capture-only-notice ? 0px : root.width * 0.12;
        y: root.capture-only-notice ? 0px : root.height * 0.54;
        width: root.capture-only-notice ? 100% : 76%;
        height: root.capture-only-notice ? 100% : 42%;
        visible: root.demo-card < 0 && root.notice-visible;
        notice-text: root.notice-text;
    }
    Rectangle {
        visible: root.demo-card >= 0;
        width: 100%; height: 100%;
        background: root.demo-card == 1 ? #302b26 : #202c2e;
        border-radius: 14px;
        border-width: 2px;
        border-color: root.demo-card == 1 ? #8c7751 : #4d6660;
        Text {
            x: root.demo-card == 2 ? 16px : 20px; y: 12px;
            text: root.demo-card == 0 ? "DEMO / THE GARDEN" : root.demo-card == 1 ? "DEMO / FIELD NOTES" : "DEMO / EXPLORE";
            color: #c8ac79; font-size: root.demo-card == 2 ? 12px : 14px; font-weight: 600;
        }
        Text {
            x: root.demo-card == 2 ? 16px : 20px; y: 33px;
            text: root.demo-card == 0 ? "Night garden" : root.demo-card == 1 ? "After hours" : "Take a\nlook";
            color: #f1dfb9; font-size: 28px; font-weight: 700;
        }
        Text {
            x: root.demo-card == 2 ? 16px : 20px;
            y: root.demo-card == 2 ? 113px : 73px;
            width: parent.width - (root.demo-card == 2 ? 32px : 40px);
            text: root.demo-card == 0 ? "Tiny worlds. Warm lights.\nA little company for your desk." : root.demo-card == 1 ? "Lanterns drift. Leaves sway.\nThere is no hurry here." : "Drag to explore\nthe garden.\n\nThe view keeps\ndrifting.";
            color: #b6c9bd; font-size: root.demo-card == 2 ? 14px : 16px;
        }
    }
}
