/*
 * Keep the 416 KiB SRAM1 bank contiguous for the two Zephyr images and the
 * DMA-capable display bands. Unused PROCPU image space is a linker-sized runtime
 * pool, not a fixed framebuffer reservation. The AMP protocol is polled directly;
 * it needs neither the inherited IPM payload nor software doorbells. Pack its
 * bounded control block into shm0 at the baseline address and offset. After
 * boot, only the unused shm0 prefix becomes runtime SRAM; the live channel and
 * following ROM-owned data range remain untouched.
 */
/ {
	soc {
		/delete-node/ memory@3fce5000;
		/delete-node/ memory@3fce5400;
		/delete-node/ ipm@3fce9400;
		/delete-node/ mbox@3fce9408;

		ipmmem0: memory@3fcee000 {
			compatible = "mmio-sram";
			reg = <0x3fcee000 0x400>;
		};

		shm0: memory@3fcee400 {
			compatible = "mmio-sram";
			reg = <0x3fcee400 0x1000>;
		};

		ipm0: ipm@3fcef400 {
			compatible = "espressif,esp32-ipm";
			reg = <0x3fcef400 0x8>;
			status = "disabled";
			shared-memory = <&ipmmem0>;
			shared-memory-size = <0x400>;
			interrupts = <79 0 0>, <80 0 0>;
			interrupt-parent = <&intc>;
		};

		mbox0: mbox@3fcef408 {
			compatible = "espressif,mbox-esp32";
			reg = <0x3fcef408 0x8>;
			status = "disabled";
			shared-memory = <&ipmmem0>;
			shared-memory-size = <0x400>;
			interrupts = <79 0 0>, <80 0 0>;
			interrupt-parent = <&intc>;
			#mbox-cells = <1>;
		};
	};
};
