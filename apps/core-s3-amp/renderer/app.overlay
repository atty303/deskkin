#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include "../amp-partitions.overlay"
#include "../amp-memory.overlay"

/ {
	chosen {
		zephyr,display = &ili9342c;
	};

	mipi_dbi: mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		zephyr,deferred-init;
		dc-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		spi-dev = <&spi2>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		ili9342c: ili9342c@0 {
			compatible = "ilitek,ili9342c";
			mipi-max-frequency = <40000000>;
			reg = <0>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
			frmctr1 = [01 1f];
			display-inversion;
			width = <320>;
			height = <240>;
			rotation = <0>;
			zephyr,deferred-init;
		};
	};
};

&ipm0 {
	status = "disabled";
};

&usb_serial {
	status = "disabled";
};

&gpio0 {
	status = "okay";
	zephyr,deferred-init;
};

&gpio1 {
	status = "okay";
	zephyr,deferred-init;
};

&dma {
	status = "okay";
	zephyr,deferred-init;
	interrupts = <DMA_IN_CH0_INTR_SOURCE IRQ_DEFAULT_PRIORITY ESP_INTR_FLAG_SHARED>,
		     <DMA_OUT_CH0_INTR_SOURCE IRQ_DEFAULT_PRIORITY ESP_INTR_FLAG_SHARED>;
	dma-channels = <2>;
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	zephyr,deferred-init;
	dma-enabled;
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	clock-frequency = <20000000>;
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
};
