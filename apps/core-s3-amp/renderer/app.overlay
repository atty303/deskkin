#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include "../amp-partitions.overlay"

/ {
	chosen {
		zephyr,display = &ili9342c;
	};

	mipi_dbi: mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		dc-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		spi-dev = <&spi2>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		ili9342c: ili9342c@0 {
			compatible = "ilitek,ili9342c";
			mipi-max-frequency = <40000000>;
			reg = <0>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
			display-inversion;
			width = <320>;
			height = <240>;
			rotation = <0>;
			zephyr,deferred-init;
		};
	};
};

&ipm0 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&dma {
	status = "okay";
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	clock-frequency = <20000000>;
	dma-enabled;
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
};
