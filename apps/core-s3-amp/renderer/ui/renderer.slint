export component RendererWindow inherits Window {
    width: 320px;
    height: 240px;
    in-out property <int> frame: 0;
    background: #11263d;

    Rectangle {
        x: Math.mod(root.frame * 7, 400) * 1px - 80px;
        y: 0px;
        width: 96px;
        height: 100%;
        background: #315d78;
    }
    Rectangle {
        x: 0px;
        y: Math.mod(root.frame * 5, 300) * 1px - 60px;
        width: 100%;
        height: 72px;
        background: #c06c5770;
    }
    Rectangle {
        x: Math.mod(root.frame * 3, 280) * 1px;
        y: Math.mod(root.frame * 2, 200) * 1px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #f2c14e;
    }
}
