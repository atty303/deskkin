import { PetSurface } from "../../../../ui/pet-surface.slint";

export component RendererWindow inherits Window {
    width: 320px;
    height: 240px;
    in-out property <image> pet-atlas;
    in-out property <int> pet-frame-index: 0;

    PetSurface {
        width: 100%;
        height: 100%;
        atlas: root.pet-atlas;
        frame-index: root.pet-frame-index;
    }
}
