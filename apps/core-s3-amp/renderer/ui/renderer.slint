import { ApplicationSurface } from "../../../../ui/application-surface.slint";
import { StatusSurface } from "../../../../ui/status-surface.slint";

export component RendererWindow inherits Window {
    in property <bool> capture-mode: false;
    in property <bool> capture-notice: false;
    in property <int> capture-demo: -1;
    in property <string> capture-status-text: "Unknown";
    in property <color> capture-status-color: #f3b33d;
    width: capture-mode ? 272px : 320px;
    height: capture-mode ? 124px : 240px;
    in-out property <image> pet-atlas;
    in-out property <int> pet-frame-index: 0;
    in property <string> shell-state: "SetupRequired";
    in property <int> shell-code: 0;
    in property <string> authentication-string: "";
    callback pair();
    callback confirm();
    callback cancel();

    background: #16191d;

    Rectangle {
        visible: !root.capture-mode;
        x: 18px;
        y: 18px;
        width: 284px;
        height: 204px;

        Text {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 24px;
            text: root.shell-state;
            color: #d7e3f4;
            font-size: 20px;
        }
        StatusSurface {
            x: 0px;
            y: 36px;
            width: 100%;
            height: 108px;
            status-text: root.authentication-string != ""
                ? root.authentication-string
                : root.shell-code == 1 ? "Ready to pair" : "Setup required";
            status-color: #f3b33d;
        }
        Rectangle {
            x: 0px;
            y: 156px;
            width: 100%;
            height: 48px;
            visible: root.shell-code == 1;
            background: #f3b33d;
            border-radius: 10px;
            Text {
                text: "Pair";
                color: #16191d;
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.pair(); }
            }
        }
        HorizontalLayout {
            x: 0px;
            y: 156px;
            width: 100%;
            height: 48px;
            spacing: 8px;
            visible: root.authentication-string != "";
            Rectangle {
                background: #f3b33d;
                border-radius: 10px;
                Text { text: "Confirm"; color: #16191d; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.confirm(); }
                }
            }
            Rectangle {
                background: #343b45;
                border-radius: 10px;
                Text { text: "Cancel"; color: #d7e3f4; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    ApplicationSurface {
        width: 100%;
        height: 100%;
        visible: root.capture-mode;
        status-text: root.capture-status-text;
        status-color: root.capture-status-color;
        notice-visible: root.capture-notice;
        notice-text: "Deskkin notice";
        capture-only-notice: root.capture-notice;
        demo-card: root.capture-demo;
    }
}
