import { Button } from "std-widgets.slint";
import { ApplicationSurface } from "../../../../ui/application-surface.slint";
import { StatusSurface } from "../../../../ui/status-surface.slint";

export component RendererWindow inherits Window {
    in property <bool> capture-mode: false;
    in property <bool> capture-notice: false;
    in property <string> capture-status-text: "Unknown";
    in property <color> capture-status-color: #f3b33d;
    width: capture-mode ? 272px : 320px;
    height: capture-mode ? 124px : 240px;
    in-out property <image> pet-atlas;
    in-out property <int> pet-frame-index: 0;
    in property <string> shell-state: "SetupRequired";
    in property <string> authentication-string: "";
    callback pair();
    callback confirm();
    callback cancel();

    background: #16191d;

    VerticalLayout {
        visible: !root.capture-mode;
        padding: 18px;
        spacing: 12px;
        Text { text: root.shell-state; color: #d7e3f4; font-size: 20px; }
        StatusSurface {
            height: 124px;
            status-text: root.authentication-string == "" ? "Setup required" : root.authentication-string;
            status-color: #f3b33d;
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Pair"; visible: root.shell-state == "ReadyToPair"; clicked => { root.pair(); } }
            Button { text: "Confirm"; visible: root.authentication-string != ""; clicked => { root.confirm(); } }
            Button { text: "Cancel"; visible: root.authentication-string != ""; clicked => { root.cancel(); } }
        }
    }

    ApplicationSurface {
        width: 100%;
        height: 100%;
        visible: root.capture-mode;
        status-text: root.capture-status-text;
        status-color: root.capture-status-color;
        notice-visible: root.capture-notice;
        notice-text: "Deskkin notice";
        capture-only-notice: root.capture-notice;
    }
}
