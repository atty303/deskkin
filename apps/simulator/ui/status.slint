import { ApplicationSurface } from "../../../ui/application-surface.slint";
import { PetSurface } from "../../../ui/pet-surface.slint";

export component StatusWindow inherits Window {
    width: 320px;
    height: 240px;
    title: "Deskkin Status";

    in property <string> status-text: "Unknown";
    in property <color> status-color: #f3b33d;
    in property <bool> notice-visible: false;
    in property <string> notice-text: "";

    background: #16191d;

    ApplicationSurface {
        x: 24px;
        y: 58px;
        width: 272px;
        height: 124px;
        status-text: root.status-text;
        status-color: root.status-color;
        notice-visible: root.notice-visible;
        notice-text: root.notice-text;
    }
}

export component PetWindow inherits Window {
    width: 320px;
    height: 240px;
    title: "Deskkin Pet";

    in property <int> pet-animation-row: 0;
    in property <int> pet-frame-index: 0;

    PetSurface {
        width: 100%;
        height: 100%;
        animation-row: root.pet-animation-row;
        frame-index: root.pet-frame-index;
    }
}
