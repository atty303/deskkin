import { ApplicationSurface } from "../../../ui/application-surface.slint";
import { PetSurface } from "../../../ui/pet-surface.slint";

export component StatusWindow inherits Window {
    width: 320px;
    height: 240px;
    title: "Deskkin Status";

    in property <string> status-text: "Unknown";
    in property <color> status-color: #f3b33d;
    in property <bool> notice-visible: false;
    in property <string> notice-text: "";
    in property <image> world-frame;
    in property <bool> world-mode: false;
    in property <bool> capture-mode: false;
    in property <bool> capture-notice: false;
    callback yaw-sample(int, bool);

    background: #16191d;

    ApplicationSurface {
        x: root.capture-mode ? 0px : 24px;
        y: root.capture-mode ? 0px : 58px;
        width: 272px;
        height: 124px;
        visible: !root.world-mode || root.capture-mode;
        status-text: root.status-text;
        status-color: root.status-color;
        notice-visible: root.capture-mode ? root.capture-notice : root.notice-visible;
        notice-text: root.notice-text;
        capture-only-notice: root.capture-mode && root.capture-notice;
    }

    Image {
        width: 100%;
        height: 100%;
        visible: root.world-mode && !root.capture-mode;
        source: root.world-frame;
        image-fit: fill;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        visible: root.world-mode && !root.capture-mode;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                root.yaw-sample(self.mouse-x / 1px, event.kind != PointerEventKind.up && event.kind != PointerEventKind.cancel);
            }
        }
        moved => { root.yaw-sample(self.mouse-x / 1px, true); }
    }
}

export component PetWindow inherits Window {
    width: 320px;
    height: 240px;
    title: "Deskkin Pet";

    in property <int> pet-animation-state: 0;
    in property <int> pet-frame-index: 0;
    property <image> pet-atlas: root.pet-animation-state == 0
        ? @image-url("../../../assets/pets/koyori/idle.qoi")
        : root.pet-animation-state == 1
            ? @image-url("../../../assets/pets/koyori/move-right.qoi")
            : root.pet-animation-state == 2
                ? @image-url("../../../assets/pets/koyori/move-left.qoi")
                : @image-url("../../../assets/pets/koyori/attend.qoi");

    PetSurface {
        width: 100%;
        height: 100%;
        atlas: root.pet-atlas;
        frame-index: root.pet-frame-index;
    }
}
