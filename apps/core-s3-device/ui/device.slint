import { Button } from "std-widgets.slint";
import { ApplicationSurface } from "../../../ui/application-surface.slint";
import { PetSurface } from "../../../ui/pet-surface.slint";
import { StatusSurface } from "../../../ui/status-surface.slint";

export component DeviceWindow inherits Window {
    width: 320px;
    height: 240px;
    background: #101820;

    in-out property <string> shell-state: "SetupRequired";
    in-out property <string> status-text: "Unknown";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> notice-visible: false;
    in-out property <string> notice-text: "";
    in-out property <string> authentication-string: "";
    in-out property <int> pet-animation-row: 0;
    in-out property <int> pet-frame-index: 0;
    property <bool> companion-visible: root.shell-state == "Paired" && root.authentication-string == "";
    callback pair();
    callback confirm();
    callback cancel();

    PetSurface {
        width: 100%;
        height: 100%;
        visible: root.companion-visible;
        animation-row: root.pet-animation-row;
        frame-index: root.pet-frame-index;
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: 104px;
        height: 30px;
        visible: root.companion-visible;
        border-radius: 15px;
        background: #d9212830;

        Text {
            text: root.status-text;
            color: root.status-color;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        visible: !root.companion-visible;
        padding: 18px;
        spacing: 12px;
        Text { text: root.shell-state; color: #d7e3f4; font-size: 20px; }
        ApplicationSurface {
            height: 92px;
            visible: root.authentication-string == "";
            status-text: root.status-text;
            status-color: root.status-color;
            notice-visible: root.notice-visible;
            notice-text: root.notice-text;
        }
        StatusSurface {
            height: 92px;
            visible: root.authentication-string != "";
            status-text: root.authentication-string;
            status-color: root.status-color;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Pair";
                visible: root.shell-state == "ReadyToPair";
                enabled: root.authentication-string == "";
                clicked => { root.pair(); }
            }
            Button {
                text: "Confirm";
                visible: root.authentication-string != "";
                clicked => { root.confirm(); }
            }
            Button {
                text: "Cancel";
                visible: root.authentication-string != "";
                clicked => { root.cancel(); }
            }
        }
    }
}
