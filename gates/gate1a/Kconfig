mainmenu "Deskkin Gate 1A"

source "Kconfig.zephyr"

config DESKKIN_GATE_MODE
	int "Gate 1A probe mode"
	range 1 2
	default 1
	help
	  Use 1 for the normal completion probe and 2 for the deliberate panic
	  probe. The integer is present in generated Rust Kconfig constants in both
	  modes, unlike a disabled boolean symbol.
