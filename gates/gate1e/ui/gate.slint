export component GateWindow inherits Window {
    width: 320px;
    height: 240px;
    background: #102030;

    in-out property <int> eye-offset: 0;
    in-out property <bool> mouth-open: false;
    callback activated();

    Rectangle {
        x: 28px;
        y: 20px;
        width: 264px;
        height: 200px;
        background: #f2c14e;

        Rectangle {
            x: 62px + root.eye-offset * 1px;
            y: 58px;
            width: 34px;
            height: 42px;
            background: #17202a;
        }

        Rectangle {
            x: 168px - root.eye-offset * 1px;
            y: 58px;
            width: 34px;
            height: 42px;
            background: #17202a;
        }

        Rectangle {
            x: 92px;
            y: 142px;
            width: 80px;
            height: 34px;
            background: #f2c14e;
            clip: true;

            Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: root.mouth-open ? 34px : 16px;
                background: root.mouth-open ? #2a9d8f : #8b1e3f;
            }
        }
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}
