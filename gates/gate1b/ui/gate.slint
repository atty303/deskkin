export component GateWindow inherits Window {
    width: 320px;
    height: 240px;
    background: #102030;

    in-out property <int> phase: 0;
    callback activated();

    Rectangle {
        x: 28px;
        y: 20px;
        width: 264px;
        height: 200px;
        background: #f2c14e;

        Rectangle {
            x: 62px + root.phase * 14px;
            y: 58px;
            width: 34px;
            height: 42px;
            background: #17202a;
            animate x { duration: 120ms; easing: linear; }
        }

        Rectangle {
            x: 168px - root.phase * 14px;
            y: 58px;
            width: 34px;
            height: 42px;
            background: #17202a;
            animate x { duration: 120ms; easing: linear; }
        }

        Rectangle {
            x: 92px;
            y: 142px;
            width: 80px;
            height: 16px + root.phase * 18px;
            background: root.phase == 0 ? #8b1e3f : #2a9d8f;
        }
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}
