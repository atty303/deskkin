From: Deskkin CoreS3 <noreply@example.invalid>
Subject: [PATCH] kconfig: enable Rust for ESP32-S3 Xtensa

This bounded product patch enables only the target paired with Deskkin's
explicit CMake mapping. Remove it with that mapping when upstream support is
available.
---
 Kconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Kconfig b/Kconfig
index 0241a6d..25d5b42 100644
--- a/Kconfig
+++ b/Kconfig
@@ -6,6 +6,7 @@ config RUST_SUPPORTED
 	bool
 	default y if ((CPU_CORTEX_M || \
 				(RISCV && !RISCV_ISA_RV32E && !RISCV_ISA_RV128I) || \
+				(XTENSA && SOC_SERIES_ESP32S3) || \
 				(ARCH_POSIX && 64BIT)) && \
 				!TIMER_READS_ITS_FREQUENCY_AT_RUNTIME)
 	help
-- 
2.50.1
