+static int mipi_dbi_esp32_dma_start_strided(const struct device *dev, const uint8_t *buffer,
+					     size_t row_bytes, size_t pitch_bytes,
+					     uint16_t row_count)
+{
+	const struct mipi_dbi_esp32_config *cfg = dev->config;
+	struct dma_status dma_status = {0};
+	struct dma_config dma_cfg = {0};
+	struct dma_block_config blocks[CONFIG_DMA_ESP32_MAX_DESCRIPTOR_NUM] = {0};
+	int ret;
+
+	if (row_count == 0U || row_count > ARRAY_SIZE(blocks) || row_bytes == 0U ||
+	    row_bytes > DMA_DESCRIPTOR_BUFFER_MAX_SIZE_4B_ALIGNED) {
+		return -ENOTSUP;
+	}
+
+	ret = dma_get_status(cfg->dma_dev, cfg->tx_dma_channel, &dma_status);
+	if (ret < 0) {
+		LOG_ERR("Unable to get DMA status (%d)", ret);
+		return ret;
+	}
+	if (dma_status.busy) {
+		return -EBUSY;
+	}
+
+	for (size_t index = 0; index < row_count; ++index) {
+		blocks[index].block_size = row_bytes;
+		blocks[index].source_address = (uint32_t)(buffer + index * pitch_bytes);
+		blocks[index].next_block = index + 1U < row_count ? &blocks[index + 1U] : NULL;
+	}
+	dma_cfg.channel_direction = MEMORY_TO_PERIPHERAL;
+	dma_cfg.dma_slot = ESP_GDMA_TRIG_PERIPH_LCD0;
+	dma_cfg.block_count = row_count;
+	dma_cfg.head_block = blocks;
+
+	ret = dma_config(cfg->dma_dev, cfg->tx_dma_channel, &dma_cfg);
+	if (ret < 0) {
+		LOG_ERR("Failed to configure strided DMA channel %u (%d)", cfg->tx_dma_channel,
+			ret);
+		return ret;
+	}
+	ret = dma_start(cfg->dma_dev, cfg->tx_dma_channel);
+	if (ret < 0) {
+		LOG_ERR("Failed to start DMA channel %u (%d)", cfg->tx_dma_channel, ret);
+	}
+	return ret;
+}
