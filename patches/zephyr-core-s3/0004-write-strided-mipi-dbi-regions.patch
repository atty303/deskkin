+/**
+ * @brief Write a rectangular view of a strided display buffer.
+ *
+ * The pitch may be greater than width. Only width pixels from each of height
+ * rows are transferred.
+ */
+static inline int mipi_dbi_write_display_strided(const struct device *dev,
+						 const struct mipi_dbi_config *config,
+						 const uint8_t *framebuf,
+						 struct display_buffer_descriptor *desc,
+						 enum display_pixel_format pixfmt)
+{
+	const struct mipi_dbi_driver_api *api =
+		(const struct mipi_dbi_driver_api *)dev->api;
+
+	return api->write_display_strided == NULL
+		       ? -ENOSYS
+		       : api->write_display_strided(dev, config, framebuf, desc, pixfmt);
