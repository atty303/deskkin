+static int mipi_dbi_esp32_write_display_strided(const struct device *dev,
+						 const struct mipi_dbi_config *dbi_cfg,
+						 const uint8_t *framebuf,
+						 struct display_buffer_descriptor *desc,
+						 enum display_pixel_format pixfmt)
+{
+	struct mipi_dbi_esp32_data *drv_data = dev->data;
+	const size_t bytes_per_pixel = 2U;
+	const size_t row_bytes = desc->width * bytes_per_pixel;
+	const size_t pitch_bytes = desc->pitch * bytes_per_pixel;
+	int ret = 0;
+
+	if ((pixfmt != PIXEL_FORMAT_RGB_565 && pixfmt != PIXEL_FORMAT_RGB_565X) ||
+	    framebuf == NULL || desc->width == 0U || desc->height == 0U ||
+	    desc->pitch <= desc->width || desc->buf_size < row_bytes * desc->height ||
+	    row_bytes > DMA_DESCRIPTOR_BUFFER_MAX_SIZE_4B_ALIGNED ||
+	    !esp_ptr_dma_capable(framebuf)) {
+		return -ENOTSUP;
+	}
+
+	k_mutex_lock(&drv_data->lock, K_FOREVER);
+	for (uint16_t row = 0; row < desc->height;) {
+		const uint16_t batch_rows =
+			MIN((uint16_t)CONFIG_DMA_ESP32_MAX_DESCRIPTOR_NUM,
+			    (uint16_t)(desc->height - row));
+		ret = mipi_dbi_esp32_transfer(dev, dbi_cfg, false, 0x00,
+					       framebuf + (size_t)row * pitch_bytes,
+					       row_bytes * batch_rows, row_bytes, pitch_bytes,
+					       batch_rows);
+		if (ret < 0) {
+			break;
+		}
+		row += batch_rows;
+	}
+	k_mutex_unlock(&drv_data->lock);
+	return ret;
+}
