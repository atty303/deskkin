From: Deskkin contributors
Subject: [PATCH] soc: esp32s3: initialize APPCPU register-window state

diff --git a/soc/espressif/esp32s3/soc_appcpu.c b/soc/espressif/esp32s3/soc_appcpu.c
index b3e2c52d3e8..6e77d386d26 100644
--- a/soc/espressif/esp32s3/soc_appcpu.c
+++ b/soc/espressif/esp32s3/soc_appcpu.c
@@ -38,6 +38,7 @@
 #define HDR_ATTR __attribute__((section(".entry_addr"))) __attribute__((used))
 
 void __appcpu_start(void);
+void __appcpu_start_c(void);
 static HDR_ATTR void (*_entry_point)(void) = &__appcpu_start;
 
 extern FUNC_NORETURN void z_prep_c(void);
@@ -51,12 +52,39 @@ static void core_intr_matrix_clear(void)
 	}
 }
 
-void IRAM_ATTR __appcpu_start(void)
+__asm__(".section .iram1,\"ax\"\n"
+        ".global __appcpu_start\n"
+        ".type __appcpu_start,@function\n"
+        "__appcpu_start:\n\t"
+        "rsr.ps a2\n\t"
+        "movi a3, 0x70f\n\t"
+        "slli a3, a3, 8\n\t"
+        "movi a4, -1\n\t"
+        "xor a3, a3, a4\n\t"
+        "and a2, a2, a3\n\t"
+        "wsr.ps a2\n\t"
+        "rsync\n\t"
+        "movi a0, 0\n\t"
+        "movi a1, 1\n\t"
+        "wsr.windowstart a1\n\t"
+        "wsr.windowbase a0\n\t"
+        "rsync\n\t"
+        "movi a1, z_interrupt_stacks + " STRINGIFY(CONFIG_ISR_STACK_SIZE) "\n\t"
+        "movi a2, " STRINGIFY(PS_UM | PS_WOE | PS_INTLEVEL(XCHAL_EXCM_LEVEL)) "\n\t"
+        "wsr.ps a2\n\t"
+        "rsync\n\t"
+        "movi a0, 0\n\t"
+        "call4 __appcpu_start_c\n\t"
+        "ill\n\t"
+        ".size __appcpu_start, .-__appcpu_start\n"
+        ".previous\n");
+
+void IRAM_ATTR __appcpu_start_c(void)
 {
 	extern uint32_t _init_start;
 
 	/* Move the exception vector table to IRAM. */
-	__asm__ __volatile__("wsr %0, vecbase" : : "r"(&_init_start));
+	__asm__ __volatile__("wsr %0, vecbase; rsync" : : "r"(&_init_start));
 
 	/* Zero out BSS.  Clobber _bss_start to avoid memset() elision. */
 	arch_bss_zero();
-- 
2.51.0

