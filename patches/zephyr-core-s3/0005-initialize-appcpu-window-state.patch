From: Deskkin contributors
Subject: [PATCH] soc: esp32s3: normalize APPCPU window state at entry

The independently loaded APPCPU image is entered without a windowed-ABI
caller or a valid Zephyr stack. Clear inherited windows and CALLINC, switch
to the first interrupt stack used by normal early boot, and tail-jump into C
so no artificial bottom frame can be spilled.

---
 soc/espressif/esp32s3/soc_appcpu.c | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/soc/espressif/esp32s3/soc_appcpu.c b/soc/espressif/esp32s3/soc_appcpu.c
index b45a928..0000000 100644
--- a/soc/espressif/esp32s3/soc_appcpu.c
+++ b/soc/espressif/esp32s3/soc_appcpu.c
@@ -38,6 +38,7 @@
 #define HDR_ATTR __attribute__((section(".entry_addr"))) __attribute__((used))
 
 void __appcpu_start(void);
+void __appcpu_start_c(void);
 static HDR_ATTR void (*_entry_point)(void) = &__appcpu_start;
 
 extern FUNC_NORETURN void z_prep_c(void);
@@ -51,7 +52,32 @@ static void core_intr_matrix_clear(void)
 	}
 }
 
-void IRAM_ATTR __appcpu_start(void)
+__asm__(".section .iram1,\"ax\"\n"
+        ".global __appcpu_start\n"
+        ".type __appcpu_start,@function\n"
+        "__appcpu_start:\n\t"
+        "rsr.ps a2\n\t"
+        "movi a3, 0x70f\n\t"
+        "slli a3, a3, 8\n\t"
+        "movi a4, -1\n\t"
+        "xor a3, a3, a4\n\t"
+        "and a2, a2, a3\n\t"
+        "wsr.ps a2\n\t"
+        "rsync\n\t"
+        "movi a0, 0\n\t"
+        "wsr.windowstart a0\n\t"
+        "movi a1, z_interrupt_stacks + " STRINGIFY(CONFIG_ISR_STACK_SIZE) " + 16\n\t"
+        "movi a3, 4\n\t"
+        "slli a3, a3, 16\n\t"
+        "or a2, a2, a3\n\t"
+        "wsr.ps a2\n\t"
+        "rsync\n\t"
+        "movi a0, 0\n\t"
+        "j __appcpu_start_c\n\t"
+        ".size __appcpu_start, .-__appcpu_start\n"
+        ".previous\n");
+
+void IRAM_ATTR __appcpu_start_c(void)
 {
 	extern uint32_t _init_start;
 
-- 
2.51.0
